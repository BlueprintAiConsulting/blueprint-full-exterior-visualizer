# =============================================================================
# BlueprintEnvision — Environment Variables
# Copy this file to .env and fill in your values for local development.
# In production, GEMINI_API_KEY is set on Render. VITE_API_BASE_URL is set 
# at build time in the GitHub Actions workflow (.github/workflows/deploy.yml).
# =============================================================================

# REQUIRED — Google Gemini API key (get one at https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key-here"

# OPTIONAL — API base URL for the frontend to call.
# Leave empty for local dev (Vite proxy handles /api/* -> localhost:3002).
# In production (GitHub Pages), this is set to the Render backend URL.
# VITE_API_BASE_URL="https://blueprint-siding-visualizer.onrender.com"

# OPTIONAL — Resend email API key for lead notification emails (https://resend.com)
# If not set, leads are logged to console but no email is sent.
RESEND_API_KEY="your-resend-api-key-here"

# OPTIONAL — Verified sending domain email address for Resend (e.g. "BlueprintEnvision <noreply@yourdomain.com>")
# Only set this if you have a verified domain in Resend. Without it, emails go to onboarding@resend.dev.
RESEND_FROM="BlueprintEnvision <noreply@yourdomain.com>"

# OPTIONAL — Email address to receive new lead notifications
LEAD_EMAIL="shilohexterior@gmail.com"
